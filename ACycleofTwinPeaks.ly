melody = {
  \global
  \time 4/4

  % ============================================================
  % I — THE ORIGINAL MOTIF
  % ============================================================

  \tempo "Adagio" 4 = 72
  

  % M1
  a'4 b' c'' b' |

  % M2
  a'4 e' d' e' |

  % M3 — EXACT REPEAT OF M1
  a'4 b' c'' b' |

  % M4 — SAME SHAPE, BUT THE E GOES UP
  a'4 e'' d'' e'' |


  % ============================================================
  % II — THE MOTIF REPEATS
  % ============================================================

  \tempo "Andante" 4 = 78

  % M5
  a'4 b' c'' b' |

  % M6
  a'4 e' d' e' |

  % M7
  a'4 b' c'' b' |

  % M8 — escalation again
  a'4 e'' d'' e'' |


  % ============================================================
  % III — SMALL DISTURBANCE
  % ============================================================

  \tempo "Andante" 4 = 88

  % M9
  a'4 b' c'' b' |

  % M10
  a'4 e' d' e' |

  % M11 — EXACTLY THE SAME AGAIN
  a'4 b' c'' b' |

  % M12
  a'4 e'' d'' e'' |


  % ============================================================
