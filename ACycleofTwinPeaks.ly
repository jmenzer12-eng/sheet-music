  % M48 — refuses to come back down
  e''8 d'' e'' f'' e'' d'' c'' b' |


  % ============================================================
  % XIII — 180 BPM
  % ============================================================

  \tempo "Presto" 4 = 180

  % M49
  a'8 b' c'' b' a' b' c'' b' |

  % M50
  a'8 e' d' e' a' e' d' e' |

  % M51
  a'8 b' c'' b' a' b' c'' b' |

  % M52
  a'8 e'' d'' e'' a' e'' d'' e'' |


  % ============================================================
  % XIV — THE CLIMAX MUTATES THE MOTIF
  % ============================================================

  % M53
  a'8 b' c'' d'' e'' d'' c'' b' |

  % M54
  a'8 e' d' e' a' e' d' e' |

  % M55
  a'8 b' c'' b' a' b' c'' d'' |

  % M56
  e''8 d'' c'' b' a' b' c'' e'' |


  % ============================================================
  % XV — THE MACHINE STARTS LOSING ENERGY
  % ============================================================

  \tempo "Vivace" 4 = 160

  % M57
  a'8 b' c'' b' a' b' c'' b' |

  % M58
  a'8 e' d' e' a' e' d' e' |

  % M59 — familiar again
  a'4 b' c'' b' |

  % M60
  a'4 e'' d'' e'' |


  % ============================================================
  % XVI — FALSE RETURN
  % ============================================================

  \tempo "Andante" 4 = 96

  % M61
  a'4 b' c'' b' |

  % M62
  a'4 e' d' e' |

  % M63
  a'4 b' c'' b' |

  % M64 — but the high E returns
  a'4 e'' d'' e'' |


  % ============================================================
  % XVII — ONE LAST SURGE
  % ============================================================

  \tempo "Presto" 4 = 180

  % M65
  a'8 b' c'' b' a' b' c'' b' |

  % M66
  a'8 e' d' e' a' e' d' e' |

  % M67
  a'8 b' c'' b' a' b' c'' b' |

  % M68 — final variation
  a'8 e'' d'' f'' e'' d'' c'' b' |


  % ============================================================
  % XVIII — RETURN WITHOUT RESOLUTION
  % ============================================================

  \tempo "Adagio" 4 = 72

  % M69
  a'4 b' c'' b' |

  % M70
  a'4 e' d' e' |

  % M71 — exact return
  a'4 b' c'' b' |

  % M72 — deliberately unresolved
  a'4 e'' d'' e'' |
}


