  \tempo "Andante" 4 = 100

  % M17
  a'8 b' c'' b' a' b' c'' b' |

  % M18
  a'8 e' d' e' a' e' d' e' |

  % M19
  a'8 b' c'' b' a' b' c'' b' |

  % M20
  a'8 e'' d'' e'' a' e'' d'' e'' |


  % ============================================================
  % VI — THE FIRST BREAK IN THE PATTERN
  % ============================================================

  \tempo "Andante" 4 = 108

  % M21 — first half familiar, second half displaced
  a'8 b' c'' b' a'4 r4 |

  % M22
  a'8 e' d' e' a'4 r4 |

  % M23 — the missing notes return
  a'8 b' c'' b' a' b' c'' b' |

  % M24
  a'8 e'' d'' e'' a' e'' d'' e'' |


  % ============================================================
  % VII — THE MOTIF REFUSES TO STAY STILL
