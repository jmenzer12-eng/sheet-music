  % ============================================================

  % M13
  a'4 b' c'' b' |

  % M14
  a'4 e' d' e' |

  % M15
  a'4 b' c'' b' |

  % M16 — THE LAST NOTE CHANGES
  a'4 e'' d'' f'' |


  % ============================================================
