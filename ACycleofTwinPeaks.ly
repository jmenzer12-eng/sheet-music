  \tempo "Allegro Moderato" 4 = 116

  % M25
  a'8 b' c'' b' a' b' c'' b' |

  % M26
  a'8 e' d' e' a' e' d' e' |

  % M27 — octave displacement of the final B
  a'8 b' c'' b' a' b' c'' d'' |

  % M28
  a'8 e'' d'' e'' a' e'' d'' e'' |


  % ============================================================
  % VIII — FIRST REAL VARIATION
  % ============================================================

  \tempo "Allegro" 4 = 126

  % M29 — same contour, different rhythm
  a'4 b'8 c'' b'4 a' |

  % M30
  a'4 e'8 d' e'4 a' |

  % M31 — original M1 rhythm returns
  a'4 b' c'' b' |

  % M32 — but M4 stretches upward
  a'4 e'' d'' f'' |


  % ============================================================
  % IX — THE MOTIF BECOMES A CURRENT
  % ============================================================

  \tempo "Allegro" 4 = 138

  % M33
  a'8 b' c'' b' a' b' c'' b' |

  % M34
  a'8 e' d' e' a' e' d' e' |

  % M35 — rising variation
  a'8 b' c'' d'' e'' d'' c'' b' |

  % M36 — falls back into the original shape
  a'8 e'' d'' e'' a' e'' d'' e'' |


  % ============================================================
  % X — 150 BPM
  % ============================================================

  \tempo "Allegro" 4 = 150

  % M37
  a'8 b' c'' b' a' b' c'' b' |

  % M38
  a'8 e' d' e' a' e' d' e' |

  % M39 — exact M37
  a'8 b' c'' b' a' b' c'' b' |

  % M40
  a'8 e'' d'' e'' a' e'' d'' e'' |


  % ============================================================
  % XI — THE PATTERN STARTS BREAKING APART
  % ============================================================

  \tempo "Vivace" 4 = 160

  % M41
  a'8 b' c'' b' a'4 b' |

  % M42
  e'8 d' e' a' e' d' e' a' |

  % M43
  a'8 b' c'' b' a' b' c'' d'' |

  % M44
  e''8 d'' e'' a' e'' d'' e'' f'' |


  % ============================================================
  % XII — 168 BPM
  % ============================================================

  \tempo "Vivace" 4 = 168

  % M45
  a'8 b' c'' b' a' b' c'' b' |

  % M46
  a'8 e' d' e' a' e' d' e' |

  % M47 — M1 begins normally, then climbs
